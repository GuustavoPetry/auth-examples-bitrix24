# Porta do servidor
PORT=3000

# Credenciais do app cadastrado no Bitrix24 (necessarias para trocar "code" por tokens)
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Usados so pelo atalho GET /oauth/authorize (testar o fluxo completo pelo navegador)
BITRIX_PORTAL_DOMAIN=empresa.bitrix24.com.br
BITRIX_REDIRECT_URI=https://seu-dominio:3000/oauth/callback
